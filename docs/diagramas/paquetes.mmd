%% Diagrama de paquetes de matera-inteligente.
%% Cada nodo es una carpeta o archivo real del repositorio (sin los __init__.py).
%% Flecha continua: import real de codigo de produccion. Punteada: main.py compone, las pruebas usan.
flowchart TB
    FRONT["frontend/ · cliente estático servido aparte (puerto 5500)<br/>index.html · css/estilos.css · js/config.js · js/app.js<br/>js/diagnostico.js · js/especies.js · js/prototipos.js<br/>js/api.js · js/escala.js · js/formato.js"]

    subgraph BACKEND["backend/ (Flask, puerto 5000)"]
        MAIN["main.py<br/>raíz de composición"]
        PRES["presentacion/<br/>rutas.py · esquemas.py · errores_http.py<br/>usa: flask, werkzeug"]
        APP["aplicacion/<br/>diagnosticar_planta.py · listar_especies.py<br/>listar_parametros.py"]
        DOM["dominio/<br/>parametros.py · rango.py · estados.py · medicion.py<br/>especie.py · diagnostico.py · reglas.py<br/>recomendaciones.py · evaluador.py<br/>servicio_diagnostico.py · puertos.py · errores.py<br/>usa: solo la biblioteca estándar de Python"]
        INFRA["infraestructura/<br/>repositorio_especies_csv.py · configuracion.py<br/>servidor_web.py<br/>usa: csv, flask, flask-cors"]
        DATOS[("datos/especies.csv")]
        TESTS["tests/<br/>dominio/ · aplicacion/ · integracion/ · dobles.py"]
    end

    FRONT -->|"HTTP + JSON (fetch)"| PRES
    PRES -->|"importa"| APP
    PRES -->|"importa"| DOM
    APP -->|"importa"| DOM
    INFRA -->|"implementa los puertos"| DOM
    INFRA -->|"lee al arrancar"| DATOS

    MAIN -.-> PRES
    MAIN -.-> APP
    MAIN -.-> DOM
    MAIN -.-> INFRA
    TESTS -.->|"dominio/ y dobles.py"| DOM
    TESTS -.->|"integracion/"| MAIN

    classDef presentacion fill:#f6ece2,stroke:#9a5b1e,stroke-width:1.5px,color:#16231b
    classDef aplicacion fill:#e6edf6,stroke:#33598a,stroke-width:1.5px,color:#16231b
    classDef dominio fill:#e3eee7,stroke:#2c6a4e,stroke-width:3px,color:#16231b
    classDef infraestructura fill:#eceef0,stroke:#5e6670,stroke-width:1.5px,color:#16231b
    classDef neutro fill:#ffffff,stroke:#8a9a8e,stroke-width:1.5px,color:#16231b

    class PRES presentacion
    class APP aplicacion
    class DOM dominio
    class INFRA,DATOS infraestructura
    class FRONT,MAIN,TESTS neutro
    style BACKEND fill:#fbfcfa,stroke:#c3d3c4,stroke-dasharray:6 4,color:#56655b

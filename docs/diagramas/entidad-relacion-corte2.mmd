%% Modelo entidad-relacion del corte 2 y del corte 3 (implementado en backend/datos/esquema.sql): una sola base SQLite.
%% Desde la fase 2 los tokens son JWT: SESION y SENSOR guardan el id del token (el reclamo jti), no el token ni su huella.
%% Las lineas punteadas llegan a PARAMETRO, que sigue en el codigo y no es una tabla.
%% Corte 3 (versiones 4 y 5 del esquema): el juego solo agrega las siete tablas marcadas "corte 3"; las de antes no cambian.
%% RELOJ_JUEGO (version 5) es una sola fila (id = 1): el reloj que eligio un admin. Sin fila, vale MATERA_MINUTOS_POR_DIA_JUEGO.
%% CUIDADO_POR_HORA y HORAS_POR_TRAMO tambien llevan usuario_id (FK a USUARIO, en cascada): esas dos lineas no se
%% dibujan para que el diagrama se lea; las de PLANTA si.
erDiagram
    USUARIO ||--o| PUNTAJE_TOTAL : "suma"
    USUARIO ||--o| JUGADOR : "responde si participa"
    USUARIO ||--o{ SESION : "abre"
    USUARIO ||--o{ PLANTA : "es dueño de"
    USUARIO ||--o{ MOVIMIENTO_PUNTAJE : "gana o pierde puntos"
    USUARIO |o--o| RELOJ_JUEGO : "lo cambió"
    ESPECIE ||--o| RITMO_CRECIMIENTO : "crece a su ritmo"
    ESPECIE ||--o{ PLANTA : "es la especie de"
    ESPECIE ||--|{ RANGO_OPTIMO : "uno por parámetro"
    PLANTA ||--o| SENSOR : "nace con"
    PLANTA ||--o{ MEDICION : "acumula"
    PLANTA |o--o{ MOVIMIENTO_PUNTAJE : "uno por lectura aceptada"
    PLANTA ||--o{ CUIDADO_POR_HORA : "una fila por hora de juego"
    PLANTA ||--o{ HORAS_POR_TRAMO : "sus horas, contadas"
    MEDICION ||--|{ LECTURA : "una por parámetro"
    PARAMETRO ||..o{ RANGO_OPTIMO : "se mide con"
    PARAMETRO ||..o{ LECTURA : "de"
    USUARIO {
        int id PK
        string correo UK
        string nombre
        string hash_contrasena "pbkdf2_sha256"
        string rol "USUARIO o ADMIN"
        int activo "1 o 0"
        string creado_en
    }
    ESPECIE {
        string nombre PK "nombre normalizado"
        string nombre_cientifico
    }
    RANGO_OPTIMO {
        string especie PK, FK
        string parametro PK
        float minimo
        float maximo
    }
    SESION {
        string token_id PK "id (jti) del JWT de usuario"
        int usuario_id FK
        string creada_en
        string vence_en
    }
    PLANTA {
        int id PK
        int usuario_id FK
        string especie FK
        string apodo "único por usuario, sin importar mayúsculas"
        string creada_en
    }
    SENSOR {
        string codigo PK "MT-0000-XX"
        int planta_id FK "único"
        string hash_clave "SHA-256 de la clave (desde el corte 3, puede llegar hecha desde la placa)"
        string vinculado_en
        string token_id "id (jti) del JWT vigente, NULL hasta el primer canje"
    }
    MEDICION {
        int id PK
        int planta_id FK
        string momento "hora de la lectura, en UTC"
        string estado "SALUDABLE, EN_RIESGO o CRITICO"
        string origen "el código del sensor (MANUAL en las de antes)"
    }
    LECTURA {
        int medicion_id PK, FK
        string parametro PK
        float valor
        string estado "BAJO, OPTIMO o ALTO"
    }
    PARAMETRO {
        string nombre PK "en parametros.py, no es tabla"
        string unidad
        float minimo_fisico
        float maximo_fisico
    }
    MOVIMIENTO_PUNTAJE {
        int id PK "orden de guardado · corte 3"
        int usuario_id FK
        int planta_id FK "NULL si se borró la planta (SET NULL)"
        string momento "hora del servidor, en UTC"
        int momento_us "el mismo momento en microsegundos"
        string estado "SALUDABLE, EN_RIESGO o CRITICO"
        int puntos "+10, -5 o -10"
    }
    CUIDADO_POR_HORA {
        int planta_id PK, FK "corte 3"
        int hora_juego PK "RelojDeJuego.numero_de_hora, al llegar"
        int usuario_id FK
        int cantidad "lecturas en esa hora"
        int suma "sus puntos"
    }
    HORAS_POR_TRAMO {
        int planta_id PK, FK "corte 3"
        int cantidad PK "lecturas de la hora"
        int suma PK "puntos de la hora"
        int usuario_id FK
        int horas "cuántas horas terminaron así"
    }
    PUNTAJE_TOTAL {
        int usuario_id PK, FK "corte 3"
        int puntos "con los de sus materas borradas"
    }
    JUGADOR {
        int usuario_id PK, FK "corte 3"
        string estado "SIN_DECIDIR, PARTICIPA o NO_PARTICIPA"
        string apodo UK "solo si participa; NOCASE"
    }
    RELOJ_JUEGO {
        int id PK "siempre 1 · corte 3"
        float minutos_por_dia "mayor que 0"
        string cambiado_en
        int cambiado_por FK "usuario; NULL si se borró (SET NULL)"
    }
    RITMO_CRECIMIENTO {
        string especie PK, FK "corte 3"
        int dias_brote
        int dias_planta
        int dias_florecida
    }

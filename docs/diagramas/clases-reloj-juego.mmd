    style pr_CambiarRelojDeJuego fill:#D5E8D4,stroke:#2e6a4e,stroke-width:4px,color:#16231b
    style RelojDeJuegoGuardado fill:#D5E8D4,stroke:#2e6a4e,stroke-width:4px,color:#16231b
    style Reloj fill:#D5E8D4,stroke:#2e6a4e,stroke-width:2px,color:#16231b
    style ConsultarRelojDeJuego fill:#FFF2CC,stroke:#8a6d12,stroke-width:4px,color:#16231b
    style CambiarRelojDeJuego fill:#FFF2CC,stroke:#8a6d12,stroke-width:4px,color:#16231b
    style RelojDeJuegoAjustable fill:#D5E8D4,stroke:#2e6a4e,stroke-width:4px,color:#16231b
    style RelojDeJuego fill:#D5E8D4,stroke:#2e6a4e,stroke-width:4px,color:#16231b
    style RelojDeJuegoInvalido fill:#D5E8D4,stroke:#2e6a4e,stroke-width:4px,color:#16231b
    style ErrorDominio fill:#D5E8D4,stroke:#2e6a4e,stroke-width:2px,color:#16231b
    style CuidadoDeMascota fill:#D5E8D4,stroke:#2e6a4e,stroke-width:4px,color:#16231b
    style Usuario fill:#D5E8D4,stroke:#2e6a4e,stroke-width:2px,color:#16231b

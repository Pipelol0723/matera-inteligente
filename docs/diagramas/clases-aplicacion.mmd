%% Presentación y aplicación: el diagnóstico y, desde el corte 2, las plantas, los sensores, el historial
%% y el aviso en vivo. Las cuentas y la administración están en clases-cuentas.mmd.
%% Morado: presentación. Amarillo: aplicación. Verde: clase del dominio que se reutiliza o puerto.
%% Borde grueso: se agregó en el corte 2.
classDiagram
    direction LR

    namespace presentacion {
        class rutas {
            <<módulo>>
            +crear_blueprint(diagnosticar, listar, listar_parametros) Blueprint
        }
        class esquemas {
            <<módulo>>
            +solicitud_desde_json(cuerpo) SolicitudDiagnostico
            +medicion_desde_json(cuerpo) Medicion
            +diagnostico_a_json(diagnostico) dict
            +especie_a_json(especie) dict
            +parametro_a_json(parametro) dict
        }
        class errores_http {
            <<módulo>>
            +registrar_manejadores(bp)
            +respuesta_error(estado_http, error, mensaje, detalle)
        }
        class EntradaInvalida {
            +error: str
            +mensaje: str
            +detalle: dict
        }
        class Autenticacion {
            +token() str
            +usuario_actual() Usuario
        }
        class rutas_plantas {
            <<módulo>>
            +crear_blueprint_plantas(...) Blueprint
            todas exigen sesión
        }
        class rutas_sensores {
            <<módulo>>
            +crear_blueprint_sensores(recibir) Blueprint
            exige la clave del sensor
        }
        class tiempo_real {
            <<módulo>>
            +crear_blueprint_tiempo_real(identificar, suscripciones, origenes) Blueprint
            WebSocket /api/v1/tiempo-real
        }
        class CanalWebSocket {
            -cola: Queue, con su hilo emisor
            +autenticado(revisar_sesion)
            +enviar(texto: str)
            +recibir(espera) str o None
            +cerrar_con_error(error, mensaje, codigo)
            +terminar()
        }
    }

    namespace aplicacion {
        class SolicitudDiagnostico {
            +especie: str
            +medicion: Medicion
        }
        class DiagnosticarPlanta {
            -servicio: ServicioDiagnostico
            +ejecutar(solicitud: SolicitudDiagnostico) Diagnostico
        }
        class ListarEspecies {
            -catalogo: CatalogoEspecies
            +ejecutar() list~Especie~
        }
        class ListarParametros {
            -parametros: tuple~Parametro~
            +ejecutar() tuple~Parametro~
        }
        class RegistrarPlanta {
            +ejecutar(usuario, apodo, especie, codigo) SensorVinculado
        }
        class ListarPlantas {
            +ejecutar(usuario) list~PlantaConEstado~
        }
        class EliminarPlanta {
            +ejecutar(usuario, planta_id)
        }
        class ReemplazarSensor {
            +ejecutar(usuario, planta_id, codigo) SensorVinculado
        }
        class SensorVinculado {
            +planta: Planta
            +codigo: CodigoSensor
            +clave: str
        }
        class ConsultarHistorial {
            +ejecutar(usuario, planta_id, limite) HistorialPlanta
        }
        class RecibirMedicionDeSensor {
            +ejecutar(codigo, clave, medicion) ResultadoMedicion
        }
        class DiagnosticarPlantaDeUsuario {
            -plantas: RepositorioPlantas
            -servicio: ServicioDiagnostico
            -historial: HistorialMediciones
            -reloj: Reloj
            -notificador: NotificadorDiagnosticos
            +ejecutar(usuario_id, planta_id, medicion, origen) ResultadoMedicion
        }
        class IdentificarUsuario {
            +ejecutar(token: str) Usuario
        }
    }

    class ServicioDiagnostico {
        <<dominio>>
        +diagnosticar(especie, medicion) Diagnostico
    }
    class Medicion {
        <<dominio>>
        +lecturas: tuple~Lectura~
    }
    class NotificadorDiagnosticos {
        <<interface>>
        +publicar(usuario_id, planta, registro, diagnostico)
    }

    rutas ..> DiagnosticarPlanta
    rutas ..> ListarEspecies
    rutas ..> ListarParametros
    rutas ..> esquemas
    rutas ..> errores_http
    esquemas ..> SolicitudDiagnostico : crea
    esquemas ..> Medicion : crea, desde aquí el dato ya no sabe de HTTP
    esquemas ..> EntradaInvalida : lanza
    errores_http ..> EntradaInvalida : atrapa
    DiagnosticarPlanta --> ServicioDiagnostico : servicio
    DiagnosticarPlanta ..> SolicitudDiagnostico

    rutas_plantas ..> Autenticacion
    rutas_plantas ..> RegistrarPlanta
    rutas_plantas ..> ListarPlantas
    rutas_plantas ..> EliminarPlanta
    rutas_plantas ..> ReemplazarSensor : PUT /plantas/{id}/sensor
    rutas_plantas ..> ConsultarHistorial
    RegistrarPlanta ..> SensorVinculado : crea, con la clave
    ReemplazarSensor ..> SensorVinculado : crea, con la clave nueva
    rutas_sensores ..> esquemas : medicion_desde_json
    rutas_sensores ..> RecibirMedicionDeSensor
    RecibirMedicionDeSensor --> DiagnosticarPlantaDeUsuario : diagnosticar
    DiagnosticarPlantaDeUsuario --> ServicioDiagnostico : reutiliza, sin cambios
    DiagnosticarPlantaDeUsuario --> NotificadorDiagnosticos : avisa después de guardar
    tiempo_real ..> IdentificarUsuario : el token del primer mensaje
    tiempo_real ..> CanalWebSocket : uno por pestaña abierta
    CanalWebSocket ..> IdentificarUsuario : revisa la sesión antes de cada mensaje
    tiempo_real ..> errores_http : 403 y 400 en JSON

    note "rutas_plantas y rutas_sensores usan esquemas_usuarios.py<br>(JSON a dominio) y errores_usuarios.py (errores a HTTP),<br>igual que rutas.py usa esquemas.py y errores_http.py.<br>esquemas_usuarios.medicion_en_vivo_a_json arma el mensaje del WebSocket.<br>NotificadorDiagnosticos lo implementa NotificadorWebSocket (ver clases-puertos)."


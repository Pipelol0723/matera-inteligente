%% Presentación y aplicación: el diagnóstico y, desde el corte 2, las plantas, los sensores y el historial.
%% Las cuentas y la administración están en clases-cuentas.mmd.
%% Morado: presentación. Amarillo: aplicación. Verde: clase del dominio que se reutiliza.
%% Borde punteado: se agrega en el corte 2 y todavía no tiene código.
classDiagram
    direction LR

    namespace presentacion {
        class rutas {
            <<módulo>>
            +crear_blueprint(diagnosticar, listar, listar_parametros) Blueprint
        }
        class esquemas {
            <<módulo>>
            +solicitud_desde_json(cuerpo) SolicitudDiagnostico
            +medicion_desde_json(cuerpo) Medicion
            +diagnostico_a_json(diagnostico) dict
            +especie_a_json(especie) dict
            +parametro_a_json(parametro) dict
        }
        class errores_http {
            <<módulo>>
            +registrar_manejadores(bp)
            +respuesta_error(estado_http, error, mensaje, detalle)
        }
        class EntradaInvalida {
            +error: str
            +mensaje: str
            +detalle: dict
        }
        class autenticacion {
            <<módulo>>
            +usuario_actual() Usuario
        }
        class rutas_plantas {
            <<módulo>>
            exigen sesión
        }
        class rutas_sensores {
            <<módulo>>
            exigen la clave del sensor
        }
    }

    namespace aplicacion {
        class SolicitudDiagnostico {
            +especie: str
            +medicion: Medicion
        }
        class DiagnosticarPlanta {
            -servicio: ServicioDiagnostico
            +ejecutar(solicitud: SolicitudDiagnostico) Diagnostico
        }
        class ListarEspecies {
            -catalogo: CatalogoEspecies
            +ejecutar() list~Especie~
        }
        class ListarParametros {
            -parametros: tuple~Parametro~
            +ejecutar() tuple~Parametro~
        }
        class RegistrarPlanta {
            +ejecutar(usuario, apodo, especie) Planta
        }
        class ListarPlantas {
            +ejecutar(usuario) list~PlantaConEstado~
        }
        class EliminarPlanta {
            +ejecutar(usuario, planta_id)
        }
        class VincularSensor {
            +ejecutar(usuario, planta_id, codigo) SensorVinculado
        }
        class DesvincularSensor {
            +ejecutar(usuario, planta_id)
        }
        class ConsultarHistorial {
            +ejecutar(usuario, planta_id, limite) list~RegistroMedicion~
        }
        class RecibirMedicionDeSensor {
            +ejecutar(codigo, clave, medicion) Diagnostico
        }
        class DiagnosticarPlantaDeUsuario {
            -servicio: ServicioDiagnostico
            +ejecutar(planta, medicion) Diagnostico
        }
    }

    class ServicioDiagnostico {
        <<dominio>>
        +diagnosticar(especie, medicion) Diagnostico
    }
    class Medicion {
        <<dominio>>
        +lecturas: tuple~Lectura~
    }

    rutas ..> DiagnosticarPlanta
    rutas ..> ListarEspecies
    rutas ..> ListarParametros
    rutas ..> esquemas
    rutas ..> errores_http
    esquemas ..> SolicitudDiagnostico : crea
    esquemas ..> Medicion : crea, desde aquí el dato ya no sabe de HTTP
    esquemas ..> EntradaInvalida : lanza
    errores_http ..> EntradaInvalida : atrapa
    DiagnosticarPlanta --> ServicioDiagnostico : servicio
    DiagnosticarPlanta ..> SolicitudDiagnostico

    rutas_plantas ..> autenticacion
    rutas_plantas ..> RegistrarPlanta
    rutas_plantas ..> ListarPlantas
    rutas_plantas ..> EliminarPlanta
    rutas_plantas ..> VincularSensor
    rutas_plantas ..> DesvincularSensor
    rutas_plantas ..> ConsultarHistorial
    rutas_sensores ..> esquemas : medicion_desde_json
    rutas_sensores ..> RecibirMedicionDeSensor
    RecibirMedicionDeSensor --> DiagnosticarPlantaDeUsuario : diagnosticar
    DiagnosticarPlantaDeUsuario --> ServicioDiagnostico : reutiliza, sin cambios

    note "rutas_plantas y rutas_sensores usan esquemas_usuarios.py<br>(JSON a dominio) y errores_usuarios.py (errores a HTTP),<br>igual que rutas.py usa esquemas.py y errores_http.py."

    style rutas fill:#E1D5E7,stroke:#8a6d99,color:#16231b
    style esquemas fill:#E1D5E7,stroke:#8a6d99,color:#16231b

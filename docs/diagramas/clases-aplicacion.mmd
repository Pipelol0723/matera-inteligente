%% Presentación y aplicación: el diagnóstico y, desde el corte 2, las plantas, los sensores, los dispositivos,
%% el historial y el aviso en vivo. Las cuentas y la administración están en clases-cuentas.mmd.
%% Hexagonal: la ruta depende del puerto de entrada (en dominio, con prefijo entrada.) y el caso de uso lo hereda.
%% El caso de uso y su puerto se llaman igual: entrada.ListarPlantas es el puerto, ListarPlantas el caso de uso.
%% Morado: presentación. Amarillo: aplicación. Verde: dominio (puerto, dato o clase que se reutiliza).
%% Borde grueso: se agregó en el corte 2 (la fase 2 hexagonal incluida).
classDiagram
    direction LR

    namespace presentacion {
        class rutas {
            <<módulo>>
            +crear_blueprint(diagnosticar, listar, listar_parametros, autenticacion) Blueprint
            todas exigen sesión (R7)
        }
        class esquemas {
            <<módulo>>
            +solicitud_desde_json(cuerpo) SolicitudDiagnostico
            +medicion_desde_json(cuerpo) Medicion
            +diagnostico_a_json(diagnostico) dict
            +especie_a_json(especie) dict
            +parametro_a_json(parametro) dict
        }
        class errores_http {
            <<módulo>>
            +registrar_manejadores(bp)
            +respuesta_error(estado_http, error, mensaje, detalle)
        }
        class EntradaInvalida {
            +error: str
            +mensaje: str
            +detalle: dict
        }
        class Autenticacion {
            -verificador: VerificadorTokens
            -identificar: entrada.IdentificarUsuario
            +con_usuario(vista) Callable
            +con_identidad(vista) Callable
        }
        class token_bearer {
            <<función>>
            +token_bearer(error) str
        }
        class rutas_plantas {
            <<módulo>>
            +crear_blueprint_plantas(registrar, listar, eliminar, reemplazar_sensor, consultar_historial, autenticacion) Blueprint
            todas exigen sesión
        }
        class rutas_dispositivos {
            <<módulo>>
            +crear_blueprint_dispositivos(canjear, registrar, verificador) Blueprint
            -con_dispositivo(verificador) decorador
            POST .../token canjea la clave
            POST .../lecturas exige el JWT del dispositivo
        }
        class esquemas_dispositivos {
            <<módulo>>
            +clave_desde_json(cuerpo) str
            +reporte_desde_json(cuerpo) ReporteDeDispositivo
            +token_a_json(token) dict
        }
        class tiempo_real {
            <<módulo>>
            +crear_blueprint_tiempo_real(verificador, identificar, suscripciones, origenes) Blueprint
            WebSocket /api/v1/tiempo-real
        }
        class CanalWebSocket {
            -cola: Queue, con su hilo emisor
            +cortado: bool
            +autenticado(revisar_sesion)
            +enviar(texto: str)
            +enviar_json(mensaje: dict)
            +recibir(espera) str o None
            +cerrar_con_error(error, mensaje, codigo)
            +terminar()
        }
        class Suscripciones {
            <<interface>>
            +conectado(usuario_id: int, canal: CanalWebSocket) ContextManager
        }
    }

    namespace dominio {
        class entrada_DiagnosticarPlanta["entrada.DiagnosticarPlanta"] {
            <<interface>>
            +ejecutar(solicitud: SolicitudDiagnostico) Diagnostico
        }
        class entrada_ListarEspecies["entrada.ListarEspecies"] {
            <<interface>>
            +ejecutar() list~Especie~
        }
        class entrada_ListarParametros["entrada.ListarParametros"] {
            <<interface>>
            +ejecutar() tuple~Parametro~
        }
        class entrada_RegistrarPlanta["entrada.RegistrarPlanta"] {
            <<interface>>
            +ejecutar(usuario, apodo, especie, codigo) SensorVinculado
        }
        class entrada_ListarPlantas["entrada.ListarPlantas"] {
            <<interface>>
            +ejecutar(usuario) list~PlantaConEstado~
        }
        class entrada_EliminarPlanta["entrada.EliminarPlanta"] {
            <<interface>>
            +ejecutar(usuario, planta_id)
        }
        class entrada_ReemplazarSensor["entrada.ReemplazarSensor"] {
            <<interface>>
            +ejecutar(usuario, planta_id, codigo) SensorVinculado
        }
        class entrada_ConsultarHistorial["entrada.ConsultarHistorial"] {
            <<interface>>
            +ejecutar(usuario, planta_id, limite) HistorialPlanta
        }
        class entrada_CanjearClaveDispositivo["entrada.CanjearClaveDispositivo"] {
            <<interface>>
            +ejecutar(codigo, clave) TokenDispositivo
        }
        class entrada_RegistrarLectura["entrada.RegistrarLectura"] {
            <<interface>>
            +ejecutar(identidad: IdentidadDispositivo, reporte: ReporteDeDispositivo) ResultadoMedicion
        }
        class entrada_IdentificarUsuario["entrada.IdentificarUsuario"] {
            <<interface>>
            +ejecutar(identidad: IdentidadUsuario) Usuario
        }
        class SolicitudDiagnostico {
            <<resultado>>
            +especie: str
            +medicion: Medicion
        }
        class SensorVinculado {
            <<resultado>>
            +planta: Planta
            +codigo: CodigoSensor
            +clave: str
        }
        class PlantaConEstado {
            <<resultado>>
            +planta: Planta
            +sensor: Sensor o None
            +ultima_medicion: RegistroMedicion o None
        }
        class HistorialPlanta {
            <<resultado>>
            +planta: Planta
            +registros: list~RegistroMedicion~
        }
        class TokenDispositivo {
            <<resultado>>
            +token: str
            +vence_en: datetime
        }
        class ResultadoMedicion {
            <<resultado>>
            +planta: Planta
            +diagnostico: Diagnostico
            +registro: RegistroMedicion
        }
        class IdentidadUsuario {
            +usuario_id: int
            +token_id: str
        }
        class IdentidadDispositivo {
            +codigo: CodigoSensor
            +token_id: str
        }
        class ReporteDeDispositivo {
            +dispositivo: CodigoSensor
            +momento: datetime
            +medicion: Medicion
        }
        class ServicioDiagnostico {
            <<dominio>>
            +diagnosticar(especie, medicion) Diagnostico
        }
        class Medicion {
            <<dominio>>
            +lecturas: tuple~Lectura~
        }
        class NotificadorDiagnosticos {
            <<interface>>
            +publicar(usuario_id, planta, registro, diagnostico)
        }
        class EmisorTokens {
            <<interface>>
            +emitir(identidad, vence_en) str
        }
        class VerificadorTokens {
            <<interface>>
            +verificar_usuario(token: str) IdentidadUsuario
            +verificar_dispositivo(token: str) IdentidadDispositivo
        }
    }

    namespace aplicacion {
        class DiagnosticarPlanta {
            -servicio: ServicioDiagnostico
            +ejecutar(solicitud: SolicitudDiagnostico) Diagnostico
        }
        class ListarEspecies {
            -catalogo: CatalogoEspecies
            +ejecutar() list~Especie~
        }
        class ListarParametros {
            -parametros: tuple~Parametro~
            +ejecutar() tuple~Parametro~
        }
        class RegistrarPlanta {
            -plantas: ConsultaPlantas
            -registro: RegistroPlantas
            -sensores: SensoresVinculados
            -especies: ConsultaRangos
            -secretos: GeneradorSecretos
            +ejecutar(usuario, apodo, especie, codigo) SensorVinculado
        }
        class ListarPlantas {
            -plantas: ConsultaPlantas
            -sensores: SensoresVinculados
            -historial: HistorialMediciones
            +ejecutar(usuario) list~PlantaConEstado~
        }
        class EliminarPlanta {
            -plantas: ConsultaPlantas
            -registro: RegistroPlantas
            +ejecutar(usuario, planta_id)
        }
        class ReemplazarSensor {
            -plantas: ConsultaPlantas
            -sensores: SensoresVinculados
            -secretos: GeneradorSecretos
            +ejecutar(usuario, planta_id, codigo) SensorVinculado
        }
        class ConsultarHistorial {
            -plantas: ConsultaPlantas
            -historial: HistorialMediciones
            +ejecutar(usuario, planta_id, limite) HistorialPlanta
        }
        class CanjearClaveDispositivo {
            -sensores: SensoresVinculados
            -credenciales: CredencialesSensor
            -plantas: ConsultaPlantas
            -cuentas: ConsultaCuentas
            -secretos: GeneradorSecretos
            -emisor: EmisorTokens
            -reloj: Reloj
            -duracion: timedelta
            +ejecutar(codigo, clave) TokenDispositivo
        }
        class RegistrarLectura {
            -credenciales: CredencialesSensor
            -cuentas: ConsultaCuentas
            -diagnosticar: DiagnosticarPlantaDeUsuario
            -reloj: Reloj
            +ejecutar(identidad: IdentidadDispositivo, reporte: ReporteDeDispositivo) ResultadoMedicion
        }
        class DiagnosticarPlantaDeUsuario {
            -plantas: ConsultaPlantas
            -servicio: ServicioDiagnostico
            -historial: HistorialMediciones
            -notificador: NotificadorDiagnosticos
            +ejecutar(usuario_id, planta_id, medicion, origen, momento) ResultadoMedicion
            sin puerto de entrada
        }
        class IdentificarUsuario {
            -sesiones: SesionesAbiertas
            -cuentas: ConsultaCuentas
            -reloj: Reloj
            +ejecutar(identidad: IdentidadUsuario) Usuario
        }
    }

    rutas ..> Autenticacion
    rutas ..> entrada_DiagnosticarPlanta
    rutas ..> entrada_ListarEspecies
    rutas ..> entrada_ListarParametros
    rutas ..> esquemas
    rutas ..> errores_http
    esquemas ..> SolicitudDiagnostico : crea
    esquemas ..> Medicion : crea, desde aquí el dato ya no sabe de HTTP
    esquemas ..> EntradaInvalida : lanza
    errores_http ..> EntradaInvalida : atrapa
    entrada_DiagnosticarPlanta <|.. DiagnosticarPlanta
    entrada_ListarEspecies <|.. ListarEspecies
    entrada_ListarParametros <|.. ListarParametros
    DiagnosticarPlanta --> ServicioDiagnostico : servicio
    DiagnosticarPlanta ..> SolicitudDiagnostico

    rutas_plantas ..> Autenticacion
    rutas_plantas ..> entrada_RegistrarPlanta
    rutas_plantas ..> entrada_ListarPlantas
    rutas_plantas ..> entrada_EliminarPlanta
    rutas_plantas ..> entrada_ReemplazarSensor : PUT /plantas/{id}/sensor
    rutas_plantas ..> entrada_ConsultarHistorial
    entrada_RegistrarPlanta <|.. RegistrarPlanta
    entrada_ListarPlantas <|.. ListarPlantas
    entrada_EliminarPlanta <|.. EliminarPlanta
    entrada_ReemplazarSensor <|.. ReemplazarSensor
    entrada_ConsultarHistorial <|.. ConsultarHistorial
    RegistrarPlanta ..> SensorVinculado : crea, con la clave
    ReemplazarSensor ..> SensorVinculado : crea, con la clave nueva
    ListarPlantas ..> PlantaConEstado : crea
    ConsultarHistorial ..> HistorialPlanta : crea

    Autenticacion ..> token_bearer
    Autenticacion ..> VerificadorTokens : verifica el JWT de usuario
    Autenticacion ..> entrada_IdentificarUsuario : le pasa la identidad, no el token
    entrada_IdentificarUsuario <|.. IdentificarUsuario
    VerificadorTokens ..> IdentidadUsuario : devuelve
    VerificadorTokens ..> IdentidadDispositivo : devuelve

    rutas_dispositivos ..> esquemas_dispositivos
    rutas_dispositivos ..> token_bearer
    rutas_dispositivos ..> VerificadorTokens : con_dispositivo verifica el JWT del dispositivo
    rutas_dispositivos ..> entrada_CanjearClaveDispositivo : POST /dispositivos/{codigo}/token
    rutas_dispositivos ..> entrada_RegistrarLectura : POST /dispositivos/{codigo}/lecturas
    esquemas_dispositivos ..> esquemas : medicion_desde_json
    esquemas_dispositivos ..> ReporteDeDispositivo : crea
    entrada_CanjearClaveDispositivo <|.. CanjearClaveDispositivo
    entrada_RegistrarLectura <|.. RegistrarLectura
    CanjearClaveDispositivo --> EmisorTokens : emisor, firma el token del dispositivo
    CanjearClaveDispositivo ..> TokenDispositivo : crea
    RegistrarLectura ..> IdentidadDispositivo
    RegistrarLectura ..> ReporteDeDispositivo
    RegistrarLectura --> DiagnosticarPlantaDeUsuario : diagnosticar
    DiagnosticarPlantaDeUsuario --> ServicioDiagnostico : reutiliza, sin cambios
    DiagnosticarPlantaDeUsuario --> NotificadorDiagnosticos : avisa después de guardar
    DiagnosticarPlantaDeUsuario ..> ResultadoMedicion : crea

    tiempo_real ..> VerificadorTokens : verifica el token del primer mensaje
    tiempo_real ..> entrada_IdentificarUsuario : la identidad del token
    tiempo_real ..> Suscripciones : registra cada canal
    tiempo_real ..> CanalWebSocket : uno por pestaña abierta
    CanalWebSocket ..> entrada_IdentificarUsuario : revisa la sesión antes de cada mensaje
    tiempo_real ..> errores_http : 403 y 400 en JSON

    note "rutas_plantas y rutas_dispositivos usan esquemas_usuarios.py<br>(JSON a dominio) y errores_usuarios.py (errores a HTTP),<br>igual que rutas.py usa esquemas.py y errores_http.py.<br>esquemas_usuarios.medicion_en_vivo_a_json arma el mensaje del WebSocket.<br>NotificadorDiagnosticos lo implementa NotificadorWebSocket, y Suscripciones<br>lo cumple CanalesTiempoReal (ver clases-puertos). Los datos de resultado<br>viven en dominio/resultados.py y los puertos en dominio/puertos_entrada.py."


    INFRA -->|"lee y escribe"| BD

    MAIN -.-> PRES
    MAIN -.-> APP
    MAIN -.-> DOM
    MAIN -.-> INFRA
    TESTS -.->|"dominio/, aplicacion/ y dobles.py"| DOM
    TESTS -.->|"integracion/"| MAIN


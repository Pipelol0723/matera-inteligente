%% Diagrama de paquetes del corte 2 (diseño, todavía sin código). Misma forma que paquetes.mmd:
%% cada caja es una carpeta y dice qué archivos se agregan y cuáles se eliminan. Punteado: nodos nuevos.
flowchart TB
    FRONT["frontend/ · cliente estático servido aparte (puerto 5500)<br/>index.html · css/estilos.css · js/config.js · js/app.js · js/api.js<br/>js/diagnostico.js · js/especies.js · js/escala.js · js/formato.js<br/>nuevos: js/sesion.js · js/acceso.js · js/cuenta.js · js/materas.js<br/>js/vincular.js · js/simulador.js · js/historial.js · js/admin.js<br/>se elimina js/prototipos.js"]
    ESP["ESP32 o simulador<br/>manda mediciones con su clave"]

    subgraph BACKEND["backend/ (Flask, puerto 5000)"]
        MAIN["main.py · raíz de composición<br/>nuevo: crear_admin.py, para la consola"]
        PRES["presentacion/<br/>rutas.py · esquemas.py · errores_http.py<br/>nuevos: autenticacion.py · rutas_usuarios.py · rutas_plantas.py<br/>rutas_sensores.py · rutas_admin.py<br/>esquemas_usuarios.py · errores_usuarios.py<br/>usa: flask, werkzeug"]
        APP["aplicacion/<br/>diagnosticar_planta.py · listar_especies.py · listar_parametros.py<br/>nuevos: cuentas.py · plantas.py · sensores.py · historial.py<br/>diagnosticar_planta_de_usuario.py · administracion.py"]
        DOM["dominio/<br/>los 12 módulos del corte 1, sin cambios<br/>nuevos: usuarios.py · plantas.py · sensores.py · historial.py<br/>puertos_usuarios.py · errores_usuarios.py<br/>usa: solo la biblioteca estándar de Python"]
        INFRA["infraestructura/<br/>configuracion.py · servidor_web.py<br/>nuevos: sqlite/ · seguridad.py · reloj.py<br/>se elimina repositorio_especies_csv.py<br/>usa: sqlite3, hashlib, secrets, flask, flask-cors"]
        SQL["datos/esquema.sql · datos/carga.sql<br/>reemplazan a especies.csv"]
        TESTS["tests/<br/>dominio/ · aplicacion/ · integracion/ · dobles.py"]
    end
    BD[("matera.sqlite<br/>fuera de Google Drive")]

    FRONT -->|"HTTP + JSON, token Bearer en lo privado"| PRES
    ESP -->|"HTTP + JSON, cabecera X-Clave-Sensor"| PRES

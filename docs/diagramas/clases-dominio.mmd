%% Clases del dominio de matera-inteligente (backend/dominio/).
%% Une el diagrama de clases de Roger (commit 3987f72) con el corte 2 y la fase 2 hexagonal.
%% Relleno verde: capa de dominio. Borde grueso: se agregó en el corte 2 o en la fase 2.
%% Los nombres son los del código. Los puertos de salida y quién los implementa están en clases-puertos.mmd.
%% Los puertos de entrada (puertos_entrada.py) están en los diagramas de aplicación.
classDiagram
    direction LR

    class Parametro {
        +nombre: str
        +unidad: str
        +minimo_fisico: float
        +maximo_fisico: float
    }
    class Lectura {
        +parametro: Parametro
        +valor: float
    }
    class Medicion {
        +lecturas: tuple~Lectura~
    }
    class Rango {
        +minimo: float
        +maximo: float
        +ancho: float
        +clasificar(valor: float) EstadoParametro
        +desviacion(valor: float) float
    }
    class Especie {
        +nombre: str
        +nombre_cientifico: str
        +rangos: Parametro → Rango
        +rango_de(parametro: Parametro) Rango
    }
    class EstadoParametro {
        <<enumeration>>
        BAJO
        OPTIMO
        ALTO
    }
    class EstadoGlobal {
        <<enumeration>>
        SALUDABLE
        EN_RIESGO
        CRITICO
    }
    class ResultadoParametro {
        +parametro: Parametro
        +valor: float
        +rango: Rango
        +estado: EstadoParametro
        +desviacion: float
        +fuera_de_rango: bool
    }
    class Diagnostico {
        +especie: str
        +estado: EstadoGlobal
        +resultados: tuple~ResultadoParametro~
        +recomendaciones: tuple~str~
    }
    class ReglaAgregacion {
        <<interface>>
        +agregar(resultados) EstadoGlobal
    }
    class ReglaHibrida {
        -umbral: float = 0.5
        +agregar(resultados) EstadoGlobal
    }
    class ReglaConteo {
        +agregar(resultados) EstadoGlobal
    }
    class GeneradorRecomendaciones {
        +para(resultado: ResultadoParametro) str o None
    }
    class EvaluadorPlanta {
        -regla: ReglaAgregacion
        -recomendaciones: GeneradorRecomendaciones
        +evaluar(especie: Especie, medicion: Medicion) Diagnostico
    }
    class ServicioDiagnostico {
        -consulta: ConsultaRangos
        -evaluador: EvaluadorPlanta
        +diagnosticar(especie: str, medicion: Medicion) Diagnostico
    }

    Medicion "1" *-- "1..*" Lectura : una por parámetro
    Lectura --> Parametro : parametro
    Especie "1" *-- "1..*" Rango : uno por parámetro
    Rango ..> EstadoParametro : clasifica
    Diagnostico "1" *-- "1..*" ResultadoParametro
    Diagnostico --> EstadoGlobal : estado
    ResultadoParametro --> Parametro : parametro
    ResultadoParametro --> Rango : rango
    ResultadoParametro --> EstadoParametro : estado
    ReglaHibrida ..|> ReglaAgregacion
    ReglaConteo ..|> ReglaAgregacion
    EvaluadorPlanta --> ReglaAgregacion : regla
    EvaluadorPlanta --> GeneradorRecomendaciones : recomendaciones
    EvaluadorPlanta ..> Diagnostico : crea
    ServicioDiagnostico --> EvaluadorPlanta : evaluador
    ServicioDiagnostico ..> Especie : la pide al puerto ConsultaRangos

    note "Errores del corte 1, heredan de ErrorDominio:<br>EspecieNoSoportada, ValorFisicamenteImposible,<br>MedicionInvalida, ParametroSinRango, RangoInvalido"

    class Rol {
        <<enumeration>>
        USUARIO
        ADMIN
    }
    class Correo {
        +valor: str
    }
    class PoliticaContrasena {
        +MINIMO: int = 8
        +validar(texto: str)$
    }
    class Usuario {
        +id: int
        +correo: Correo
        +nombre: str
        +hash_contrasena: str
        +rol: Rol
        +activo: bool
        +es_admin() bool
        +exigir_admin()
        +exigir_otro_usuario(usuario_id: int)
        +con_estado(activo: bool) Usuario
        +con_rol(rol: Rol) Usuario
    }
    class ResumenUsuario {
        +id: int
        +correo: str
        +nombre: str
        +rol: Rol
        +activo: bool
        +cantidad_plantas: int
    }
    class Sesion {
        +token_id: str
        +usuario_id: int
        +vence_en: datetime
        +abrir(token_id, usuario_id, ahora, duracion)$ Sesion
        +vigente(ahora: datetime) bool
    }
    class Planta {
        +id: int
        +usuario_id: int
        +apodo: str
        +especie: str
        +es_de(usuario_id: int) bool
        +exigir_dueno(usuario_id: int)
        +mismo_apodo(apodo: str) bool
    }
    class CodigoSensor {
        +valor: str
    }
    class Sensor {
        +codigo: CodigoSensor
        +planta_id: int
        +hash_clave: str
    }
    class RegistroMedicion {
        +planta_id: int
        +momento: datetime
        +estado: EstadoGlobal
        +lecturas: tuple~LecturaRegistrada~
        +origen: str
        +desde(diagnostico, planta_id, momento, origen)$ RegistroMedicion
    }
    class LecturaRegistrada {
        +parametro: Parametro
        +valor: float
        +estado: EstadoParametro
    }

    %% Fase 2: quién hace el pedido (identidad.py) y lo que reporta un dispositivo (reportes.py)
    class IdentidadUsuario {
        +usuario_id: int
        +token_id: str
    }
    class IdentidadDispositivo {
        +codigo: CodigoSensor
        +token_id: str
    }
    class ReporteDeDispositivo {
        +dispositivo: CodigoSensor
        +momento: datetime
        +medicion: Medicion
        +exigir_que_no_sea_futuro(ahora: datetime)
    }

    %% Fase 2: lo que entra y sale de los puertos de entrada (resultados.py), datos sin lógica
    class SolicitudDiagnostico {
        +especie: str
        +medicion: Medicion
    }
    class SesionIniciada {
        +token: str
        +vence_en: datetime
        +usuario: Usuario
    }
    class CuentaUsuario {
        +usuario: Usuario
        +cantidad_plantas: int
    }
    class SensorVinculado {
        +planta: Planta
        +codigo: CodigoSensor
        +clave: str
    }
    class PlantaConEstado {
        +planta: Planta
        +sensor: Sensor o None
        +ultima_medicion: RegistroMedicion o None
    }
    class HistorialPlanta {
        +planta: Planta
        +registros: list~RegistroMedicion~
    }
    class TokenDispositivo {
        +token: str
        +vence_en: datetime
    }
    class ResultadoMedicion {
        +planta: Planta
        +diagnostico: Diagnostico
        +registro: RegistroMedicion
    }

    Usuario *-- Correo : correo
    Usuario --> Rol : rol
    ResumenUsuario --> Rol : rol
    PoliticaContrasena ..> Usuario : valida la contraseña al registrar
    Usuario "1" --> "0..*" Sesion : abre
    Usuario "1" --> "0..*" Planta : es dueño de
    Planta ..> Especie : especie
    Planta "1" --> "0..1" Sensor : nace con
    Sensor *-- CodigoSensor : codigo
    Planta "1" --> "0..*" RegistroMedicion : acumula
    RegistroMedicion "1" *-- "1..*" LecturaRegistrada
    RegistroMedicion --> EstadoGlobal : estado
    LecturaRegistrada --> Parametro : parametro
    LecturaRegistrada --> EstadoParametro : estado
    RegistroMedicion ..> Diagnostico : se construye desde
    IdentidadDispositivo --> CodigoSensor : codigo
    ReporteDeDispositivo --> CodigoSensor : dispositivo
    ReporteDeDispositivo --> Medicion : medicion
    SolicitudDiagnostico --> Medicion : medicion
    SesionIniciada --> Usuario : usuario
    CuentaUsuario --> Usuario : usuario
    SensorVinculado --> Planta : planta
    SensorVinculado --> CodigoSensor : codigo
    PlantaConEstado --> Planta : planta
    PlantaConEstado --> "0..1" Sensor : sensor
    PlantaConEstado --> "0..1" RegistroMedicion : ultima_medicion
    HistorialPlanta --> Planta : planta
    HistorialPlanta --> "0..*" RegistroMedicion : registros
    ResultadoMedicion --> Planta : planta
    ResultadoMedicion --> Diagnostico : diagnostico
    ResultadoMedicion --> RegistroMedicion : registro

    note for IdentidadUsuario "token_id es el jti del JWT. Mientras exista una Sesion<br>con ese token_id el token sirve: cerrar la sesión o<br>desactivar la cuenta lo invalida aunque no haya vencido."
    note for IdentidadDispositivo "token_id es el del último canje de la clave: un canje<br>nuevo, o cambiar el sensor de la planta, invalida los anteriores."
    note for ReporteDeDispositivo "Al construirse exige una hora con zona horaria; después,<br>exigir_que_no_sea_futuro tolera ADELANTO_MAXIMO = 2 minutos<br>de adelanto. Las dos reglas lanzan MomentoInvalido."

    note "Errores del corte 2 (errores_usuarios.py), heredan de ErrorDominio:<br>CorreoInvalido, NombreInvalido, ContrasenaDebil, CorreoYaRegistrado,<br>CredencialesInvalidas, CuentaDesactivada, SesionInvalida,<br>PermisoDenegado, AccionSobreSiMismo, UsuarioNoEncontrado,<br>EspecieYaExiste, PlantaNoEncontrada, ApodoInvalido, ApodoRepetido,<br>CodigoSensorInvalido, SensorYaVinculado, ClaveSensorInvalida<br>Errores de la fase 2, en el mismo archivo:<br>TablaDeSoloLectura, AlcanceInvalido, CredencialDispositivoInvalida,<br>DispositivoAjeno, MomentoInvalido"


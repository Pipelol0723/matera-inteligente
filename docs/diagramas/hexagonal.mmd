%% Vista hexagonal del backend (fase 2 y corte 3): adaptadores de entrada a la izquierda, el nucleo al centro
%% (puertos de entrada, casos de uso, reglas y puertos de salida) y adaptadores de salida a la derecha,
%% con los nombres reales de archivos y clases.
%% Todas las flechas apuntan hacia el nucleo: los adaptadores conocen los puertos y el nucleo no conoce
%% a los adaptadores. Los enlaces invisibles (~~~) solo ordenan el dibujo de izquierda a derecha.
%% Colores por capa, los mismos de los diagramas de clases: morado presentacion, amarillo aplicacion,
%% verde dominio y azul infraestructura. Borde grueso: se agrego en el corte 3 (el juego y la conexion).
%% GET /red no pasa por el nucleo: no tiene regla de negocio, y main.py le pasa a rutas_red.py las funciones
%% de RedLocal (presentacion no importa infraestructura). Por eso no tiene flecha: lo dicen las dos cajas.
flowchart LR
    NAV["Front en el navegador<br/>(fetch cada 10 s y WebSocket)"]
    ESP["ESP32 o<br/>simulador/simulador_esp32.py<br/>(HTTP con su JWT)"]
    MAIN["main.py<br/>único punto de composición:<br/>elige el adaptador de cada puerto<br/>(MATERA_TABLA_REFERENCIA: SQLite o CSV;<br/>AvisarATodos con PuntuarLectura y NotificadorWebSocket;<br/>MATERA_MINUTOS_POR_DIA_JUEGO: el reloj del juego)"]

    subgraph ENT["Entrada · presentacion/"]
        direction TB
        RED["GET /red · rutas_red.py<br/>sin puerto: main.py le pasa<br/>las funciones de RedLocal"]
        JUEGO["Rutas del juego<br/>rutas_juego.py · esquemas_juego.py<br/>errores_juego.py<br/>decorador Autenticacion.con_usuario,<br/>el mismo de las rutas del front"]
        PRUEBAS["Pruebas unitarias<br/>tests/dominio · tests/aplicacion<br/>(dobles de los puertos de salida,<br/>también los del juego)"]
        CONSOLA["Consola<br/>crear_admin.py<br/>exportar_especies_csv.py"]
        DISP["Rutas de dispositivos<br/>rutas_dispositivos.py<br/>decorador con_dispositivo"]
        FRONT["Rutas del front<br/>rutas.py · rutas_usuarios.py<br/>rutas_plantas.py · rutas_admin.py<br/>decorador Autenticacion.con_usuario"]
        WS["WebSocket<br/>tiempo_real.py<br/>verifica el JWT del primer mensaje<br/>con VerificadorTokens.verificar_usuario"]
    end

    subgraph NUCLEO["Núcleo · dominio/ + aplicacion/"]
        PEJ["Puertos de entrada del juego<br/>dominio/puertos_juego.py<br/><br/>ConsultarMascotas · ConsultarPuntaje<br/>ConsultarParticipacion<br/>ElegirParticipacion<br/>ConsultarTablaPosiciones"]
        PE["Puertos de entrada<br/>dominio/puertos_entrada.py<br/><br/>DiagnosticarPlanta · ListarEspecies<br/>ListarParametros · RegistrarUsuario<br/>IniciarSesion · CerrarSesion<br/>IdentificarUsuario · ConsultarCuenta<br/>RegistrarPlanta · ListarPlantas<br/>EliminarPlanta · ReemplazarSensor<br/>ConsultarHistorial<br/>CanjearClaveDispositivo · RegistrarLectura<br/>ListarUsuarios · CambiarEstadoUsuario<br/>CambiarRol · EliminarUsuario<br/>AgregarEspecie · ConvertirEnAdministrador<br/><br/>corte 3: RegistrarPlanta y ReemplazarSensor<br/>reciben una huella opcional"]
        CU["Casos de uso · aplicacion/<br/>cada uno hereda el puerto<br/>de su mismo nombre<br/>(más DiagnosticarPlantaDeUsuario)"]
        CUJ["Casos de uso del juego<br/>aplicacion/juego.py: los cinco del juego<br/>y PuntuarLectura<br/>aplicacion/avisos.py: AvisarATodos<br/>(los dos implementan NotificadorDiagnosticos)"]
        REGLASJ["Reglas del juego<br/>dominio/juego.py · mascota.py<br/><br/>ReglaDeCuidado · ApodoJugador<br/>Participacion.exigir_participacion<br/>CuidadoDeMascota · RitmoCrecimiento<br/>RelojDeJuego · necesidad_principal<br/>(leen EstadoGlobal y RegistroMedicion,<br/>sin cambiar las reglas de antes)"]
        PSJ["Puertos de salida del juego<br/>dominio/puertos_juego.py<br/><br/>MovimientosPuntaje<br/>RegistroJugadores<br/>RitmosCrecimiento"]
        PS["Puertos de salida<br/>dominio/puertos.py · puertos_usuarios.py<br/><br/>ConsultaRangos · CatalogoEspecies<br/>RegistroEspecies · ConsultaCuentas<br/>RegistroCuentas · ListadoCuentas<br/>SesionesAbiertas · ConsultaPlantas<br/>RegistroPlantas · SensoresVinculados<br/>CredencialesSensor · HistorialMediciones<br/>NotificadorDiagnosticos · EmisorTokens<br/>VerificadorTokens · Cifrador<br/>GeneradorSecretos · Reloj"]
        REGLAS["Reglas del dominio<br/>sin Flask, SQLite, CSV, JWT, JSON ni HTTP<br/><br/>Lectura · Medicion · Especie · Rango<br/>ServicioDiagnostico · EvaluadorPlanta<br/>ReglaHibrida · Planta.exigir_dueno<br/>Usuario.exigir_admin<br/>ReporteDeDispositivo<br/>IdentidadUsuario · IdentidadDispositivo"]
    end

    subgraph SAL["Salida · infraestructura/"]
        direction TB
        SQLJ["SQLite del juego<br/>sqlite/repositorio_juego.py<br/>MovimientosPuntajeSqlite<br/>RegistroJugadoresSqlite<br/>RitmosCrecimientoSqlite"]
        CSV["CSV · repositorio_especies_csv.py<br/>RepositorioEspeciesCsv<br/>EspeciesDeSoloLectura<br/>RegistroEspeciesConCopiaCsv"]
        JWT["JWT · tokens_jwt.py<br/>TokensJwt (PyJWT)"]
        OTROS["seguridad.py · reloj.py · tiempo_real.py<br/>CifradorPbkdf2 · GeneradorSecretosSeguro<br/>RelojSistema · NotificadorWebSocket"]
        SQLITE["SQLite · sqlite/<br/>RepositorioUsuariosSqlite<br/>RepositorioSesionesSqlite<br/>RepositorioPlantasSqlite<br/>RepositorioSensoresSqlite<br/>HistorialMedicionesSqlite<br/>RepositorioEspeciesSqlite"]
        REDL["red_local.py · RedLocal<br/>las IPv4 del PC, para GET /red<br/>(no implementa un puerto)"]
    end

    NAV --> FRONT
    NAV --> JUEGO
    NAV --> RED
    NAV --> WS
    ESP --> DISP
    MAIN -. "conecta los adaptadores<br/>de entrada y de salida" .-> ENT

    FRONT --> PE
    JUEGO --> PEJ
    RED ~~~ PEJ
    WS --> PE
    DISP --> PE
    CONSOLA --> PE
    PRUEBAS --> PE
    FRONT -- "verificar_usuario" --> PS
    DISP -- "verificar_dispositivo" --> PS

    PE ~~~ CU
    PEJ ~~~ CUJ
    CU -. "implementa" .-> PE
    CUJ -. "implementa" .-> PEJ
    CU --> REGLAS
    CU --> PS
    CUJ --> REGLASJ
    CUJ --> PSJ
    CUJ -- "ConsultaPlantas, HistorialMediciones,<br/>ConsultaCuentas, Reloj" --> PS
    CUJ -. "PuntuarLectura y AvisarATodos<br/>implementan NotificadorDiagnosticos" .-> PS

    PSJ ~~~ SQLJ
    PS ~~~ CSV
    PS ~~~ JWT
    PS ~~~ OTROS
    PS ~~~ SQLITE
    SQLITE -. "implementa" .-> PS
    SQLJ -. "implementa" .-> PSJ
    CSV -. "implementa" .-> PS
    JWT -. "implementa" .-> PS
    OTROS -. "implementa" .-> PS
    PS ~~~ REDL

    classDef presentacion fill:#E1D5E7,stroke:#6a3d80,stroke-width:2px,color:#16231b
    classDef aplicacion fill:#FFF2CC,stroke:#8a6d12,stroke-width:2px,color:#16231b
    classDef dominio fill:#D5E8D4,stroke:#2e6a4e,stroke-width:2px,color:#16231b
    classDef infraestructura fill:#DAE8FC,stroke:#2f5f99,stroke-width:2px,color:#16231b
    classDef presentacionNuevo fill:#E1D5E7,stroke:#6a3d80,stroke-width:4px,color:#16231b
    classDef aplicacionNuevo fill:#FFF2CC,stroke:#8a6d12,stroke-width:4px,color:#16231b
    classDef dominioNuevo fill:#D5E8D4,stroke:#2e6a4e,stroke-width:4px,color:#16231b
    classDef infraestructuraNuevo fill:#DAE8FC,stroke:#2f5f99,stroke-width:4px,color:#16231b
    classDef externo fill:#ffffff,stroke:#8a9a8e,stroke-width:1.5px,color:#16231b
    class FRONT,DISP,WS,CONSOLA,PRUEBAS presentacion
    class JUEGO,RED presentacionNuevo
    class CU aplicacion
    class CUJ aplicacionNuevo
    class PE,REGLAS,PS dominio
    class PEJ,REGLASJ,PSJ dominioNuevo
    class SQLITE,CSV,JWT,OTROS infraestructura
    class SQLJ,REDL infraestructuraNuevo
    class ESP,NAV,MAIN externo
    style NUCLEO fill:#f7fbf6,stroke:#2e6a4e,stroke-width:3px,color:#16231b
    style ENT fill:#fbf8fc,stroke:#c9b8d3,color:#16231b
    style SAL fill:#f6f9fd,stroke:#b9cbe3,color:#16231b

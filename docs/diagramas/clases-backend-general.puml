@startuml diagrama-clases

title Matera inteligente — Diagrama de clases (backend)\n(incluye cuentas, plantas, sensores e historial: implementado en el corte 2)

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam packageStyle rectangle
skinparam class {
  BackgroundColor White
  ArrowColor #333333
  BorderColor #333333
}
skinparam interface {
  BackgroundColor #1BA1E2
  FontColor White
  BorderColor #333333
}
skinparam enum {
  BackgroundColor #1BA1E2
  FontColor White
  BorderColor #333333
}

package "presentacion" #E1D5E7 {
  class "rutas" as RutasApiV1 <<modulo>> {
    + crear_blueprint(diagnosticar, listar, listarParametros): Blueprint
    Diagnostico y Especies: publicas, sin tocar
  }

  class "rutas_usuarios, rutas_admin,\nrutas_plantas, rutas_sensores" as RutasCuentas <<modulo>> {
    + crear_blueprint_usuarios/_admin/_plantas/_sensores(...): Blueprint
    cada una exige sesion con Autenticacion, menos sensores (clave propia)
  }

  class "esquemas" as EsquemasJson <<modulo>> {
    + solicitud_desde_json(cuerpo): SolicitudDiagnostico
    + diagnostico_a_json(diagnostico): dict
  }

  class "esquemas_usuarios" as EsquemasUsuariosJson <<modulo>> {
    + registro_desde_json / credenciales_desde_json / planta_desde_json(cuerpo)
    + usuario_a_json / sesion_a_json / tarjeta_a_json / historial_a_json(...)
  }

  class EntradaInvalida {
    + error: string
    + mensaje: string
    + detalle: dict
  }

  class "errores_http, errores_usuarios" as ErroresHttp <<modulo>> {
    + registrar_manejadores(bp): void
  }

  class Autenticacion {
    - identificar: IdentificarUsuario
    + token(): string
    + usuario_actual(): Usuario
  }

  class "websocket" as WebSocketPlantas <<modulo>> <<futuro>> #CCCCCC {
    + al_conectar(data): void
    + al_recibir_medicion(data): void
  }
}

package "aplicacion" #FFF2CC {
  class SolicitudDiagnostico {
    + especie: string
    + medicion: Medicion
  }

  class DiagnosticarPlanta {
    - servicio: ServicioDiagnostico
    + ejecutar(solicitud: SolicitudDiagnostico): Diagnostico
  }

  class ListarEspecies {
    - catalogo: CatalogoEspecies
    + ejecutar(): Especie[]
  }

  class ListarParametros {
    - parametros: Parametro[]
    + ejecutar(): Parametro[]
  }

  class IniciarSesion {
    - usuarios: RepositorioUsuarios
    - sesiones: RepositorioSesiones
    - cifrador: Cifrador
    - secretos: GeneradorSecretos
    + ejecutar(correo, contrasena): SesionIniciada
  }

  class "RegistrarUsuario, CerrarSesion,\nIdentificarUsuario, ConsultarCuenta" as CasosDeCuenta {
    mismas dependencias que IniciarSesion:\nsolo puertos, nunca Flask ni SQL
  }

  class "ListarUsuarios, CambiarEstadoUsuario,\nCambiarRol, EliminarUsuario,\nAgregarEspecie" as CasosDeAdmin {
    + ejecutar(actor, ...)
    cada uno empieza con actor.exigir_admin()
  }

  class RegistrarPlanta {
    - plantas: RepositorioPlantas
    - especies: ConsultaRangos
    + ejecutar(usuario, apodo, especie): Planta
  }

  class "ListarPlantas, EliminarPlanta,\nConsultarHistorial" as CasosDePlanta {
    la planta siempre se busca junto con su dueno:\najena o inexistente dan el mismo error
  }

  class VincularSensor {
    - plantas: RepositorioPlantas
    - sensores: RepositorioSensores
    - secretos: GeneradorSecretos
    + ejecutar(usuario, plantaId, codigo): SensorVinculado
  }

  class DiagnosticarPlantaDeUsuario {
    - plantas: RepositorioPlantas
    - servicio: ServicioDiagnostico
    - historial: HistorialMediciones
    + ejecutar(usuarioId, plantaId, medicion, origen): ResultadoMedicion
  }

  class RecibirMedicionDeSensor {
    - sensores: RepositorioSensores
    - diagnosticar: DiagnosticarPlantaDeUsuario
    + ejecutar(codigo, clave, medicion): ResultadoMedicion
  }

  note as NotaCasosDeUso
    La manual (usuario con sesion) y la del sensor
    (codigo + clave) terminan en el mismo
    DiagnosticarPlantaDeUsuario, que reutiliza
    ServicioDiagnostico del corte 1 sin tocarlo.
  end note
}

package "dominio" #D5E8D4 {

  interface ReglaAgregacion {
    + agregar(resultados: ResultadoParametro[]): EstadoGlobal
  }

  interface ConsultaRangos {
    + rangos_de(especie: string): Especie
  }

  interface CatalogoEspecies {
    + listar(): Especie[]
  }

  class EvaluadorPlanta {
    - regla: ReglaAgregacion
    - recomendaciones: GeneradorRecomendaciones
    + evaluar(especie: Especie, medicion: Medicion): Diagnostico
  }

  class ServicioDiagnostico {
    - consulta: ConsultaRangos
    - evaluador: EvaluadorPlanta
    + diagnosticar(especie: string, medicion: Medicion): Diagnostico
  }

  class GeneradorRecomendaciones {
    + para(resultado: ResultadoParametro): string
  }

  class ReglaHibrida {
    - umbral: float = 0.5
    + agregar(resultados: ResultadoParametro[]): EstadoGlobal
  }

  class ReglaConteo {
    + agregar(resultados: ResultadoParametro[]): EstadoGlobal
  }

  class Parametro {
    + nombre: string
    + unidad: string
    + minimoFisico: float
    + maximoFisico: float
  }

  class Especie {
    + nombre: string
    + rangos: Map<Parametro, Rango>
    + nombreCientifico: string
    + rango_de(parametro: Parametro): Rango
  }

  class Rango {
    + minimo: float
    + maximo: float
    + ancho: float
    + clasificar(valor: float): EstadoParametro
    + desviacion(valor: float): float
  }

  enum EstadoParametro {
    BAJO
    OPTIMO
    ALTO
  }

  enum EstadoGlobal {
    SALUDABLE
    EN_RIESGO
    CRITICO
  }

  class Lectura {
    + parametro: Parametro
    + valor: float
  }

  class Medicion {
    + lecturas: Lectura[]
  }

  class ResultadoParametro {
    + parametro: Parametro
    + valor: float
    + rango: Rango
    + estado: EstadoParametro
    + desviacion: float
    + fueraDeRango: bool
  }

  class Diagnostico {
    + especie: string
    + estado: EstadoGlobal
    + resultados: ResultadoParametro[]
    + recomendaciones: string[]
  }

  note as ErroresDominio
    dominio.errores.py
    ErrorDominio (base)
    -> EspecieNoSoportada
    -> ValorFisicamenteImposible
    -> MedicionInvalida
    -> ParametroSinRango
    -> RangoInvalido
  end note

  ' ---- corte 2: cuentas, plantas, sensores e historial ----

  enum Rol {
    USUARIO
    ADMIN
  }

  class Usuario {
    + id: int
    + correo: Correo
    + nombre: string
    + rol: Rol = USUARIO
    + activo: bool = true
    + es_admin(): bool
    + exigir_admin(): void
  }

  class Sesion {
    - hashToken: string
    + usuarioId: int
    + venceEn: datetime
    + vigente(ahora: datetime): bool
  }

  class Planta {
    + id: int
    + usuarioId: int
    + apodo: string
    + especie: string
    + es_de(usuarioId: int): bool
  }

  class Sensor {
    + codigo: CodigoSensor
    + plantaId: int
    - hashClave: string
  }

  class RegistroMedicion {
    + plantaId: int
    + momento: datetime
    + estado: EstadoGlobal
    + lecturas: LecturaRegistrada[]
    + origen: string
  }

  interface "RepositorioUsuarios, RepositorioSesiones,\nRepositorioPlantas, RepositorioSensores,\nHistorialMediciones, RegistroEspecies" as PuertosUsuarios {
    un puerto por agregado (ISP):\nquien solo diagnostica no depende de cuentas
  }

  interface Cifrador {
    + cifrar(texto: string): string
    + verificar(texto: string, cifrado: string): bool
  }

  interface GeneradorSecretos {
    + nuevo(): string
    + huella(secreto: string): string
    + coincide(secreto: string, huella: string): bool
  }

  interface Reloj {
    + ahora(): datetime
  }

  note as ErroresUsuariosDominio
    dominio.errores_usuarios.py (17 errores)
    CorreoYaRegistrado, CredencialesInvalidas,
    SesionInvalida, PermisoDenegado,
    PlantaNoEncontrada (404: igual si es ajena),
    SensorYaVinculado, ClaveSensorInvalida...
  end note
}

package "infraestructura" #DAE8FC {
  class Configuracion {
    + puerto: int
    + rutaBd: Path
    + origenesCors: string[]
    + duracionSesion: timedelta = 7 dias
    + {static} desdeEntorno(): Configuracion
  }

  class BaseDatos {
    - ruta: Path
    + conexion(): Connection
    + preparar(esquema, carga): BaseDatos
  }

  class "RepositorioEspeciesSqlite,\nRepositorioUsuariosSqlite, RepositorioSesionesSqlite,\nRepositorioPlantasSqlite, RepositorioSensoresSqlite,\nHistorialMedicionesSqlite" as ReposSqlite {
    una conexion de SQLite por operacion,\nFlask atiende cada request en su propio hilo
  }

  class CifradorPbkdf2 {
    - iteraciones: int = 600 000
    + cifrar/verificar(...): ...
  }

  class GeneradorSecretosSeguro {
    tokens y claves: 32 bytes aleatorios,\nguardados solo como SHA-256
  }

  class RelojSistema {
    + ahora(): datetime
  }

  class "mqtt_listener" as MqttListener <<modulo>> <<futuro>> #CCCCCC {
    + al_llegar_mensaje_mqtt(payload): void
  }

  interface NotificadorDiagnosticos <<futuro>> {
    + publicar(usuarioId: string, diagnostico: Diagnostico): void
  }

  class NotificadorWebSocket <<futuro>> #CCCCCC {
  }
}

' ---- presentacion: rutas -> casos de uso, esquemas y manejo de errores ----
RutasApiV1 ..> DiagnosticarPlanta
RutasApiV1 ..> ListarEspecies
RutasApiV1 ..> ListarParametros
RutasApiV1 ..> EsquemasJson
RutasApiV1 ..> ErroresHttp
EsquemasJson ..> SolicitudDiagnostico : crea
EsquemasJson ..> EntradaInvalida : lanza
EsquemasJson ..> Diagnostico
ErroresHttp ..> EntradaInvalida
ErroresHttp ..> ErroresDominio : atrapa
ErroresHttp ..> ErroresUsuariosDominio : atrapa

RutasCuentas ..> CasosDeCuenta
RutasCuentas ..> IniciarSesion
RutasCuentas ..> CasosDeAdmin
RutasCuentas ..> RegistrarPlanta
RutasCuentas ..> CasosDePlanta
RutasCuentas ..> VincularSensor
RutasCuentas ..> DiagnosticarPlantaDeUsuario
RutasCuentas ..> RecibirMedicionDeSensor
RutasCuentas ..> Autenticacion
RutasCuentas ..> EsquemasUsuariosJson
Autenticacion --> CasosDeCuenta : identificar

' ---- realizaciones (implementa la interfaz) ----
ReglaHibrida ..|> ReglaAgregacion
ReglaConteo ..|> ReglaAgregacion
ReposSqlite ..|> ConsultaRangos
ReposSqlite ..|> CatalogoEspecies
ReposSqlite ..|> PuertosUsuarios
CifradorPbkdf2 ..|> Cifrador
GeneradorSecretosSeguro ..|> GeneradorSecretos
RelojSistema ..|> Reloj
ReposSqlite --> BaseDatos : bd
NotificadorWebSocket ..|> NotificadorDiagnosticos

' ---- composicion / agregacion ----
Medicion "1" *-- "1..3" Lectura
Diagnostico "1" *-- "1..*" ResultadoParametro
Especie "1" o-- "0..*" Rango : rangos
ListarParametros o-- "0..*" Parametro
RegistroMedicion "1" *-- "1..*" Lectura

' ---- asociaciones (dependencia por constructor): corte 1 ----
EvaluadorPlanta --> ReglaAgregacion : regla
EvaluadorPlanta --> GeneradorRecomendaciones : recomendaciones
ServicioDiagnostico --> ConsultaRangos : consulta
ServicioDiagnostico --> EvaluadorPlanta : evaluador
DiagnosticarPlanta --> ServicioDiagnostico : servicio
ListarEspecies --> CatalogoEspecies : catalogo
Lectura --> Parametro : parametro
ResultadoParametro --> Parametro : parametro
ResultadoParametro --> EstadoParametro : estado
Diagnostico --> EstadoGlobal : estado
SolicitudDiagnostico --> Medicion : medicion
DiagnosticarPlanta ..> SolicitudDiagnostico

' ---- corte 2: dominio y dependencias por constructor ----
Usuario --> Rol : rol
IniciarSesion --> PuertosUsuarios : usuarios, sesiones
IniciarSesion --> Cifrador : cifrador
IniciarSesion --> GeneradorSecretos : secretos
IniciarSesion ..> Sesion : abre
CasosDeCuenta --> PuertosUsuarios
CasosDeAdmin --> PuertosUsuarios
CasosDeAdmin ..> Usuario : actor.exigir_admin()
RegistrarPlanta --> PuertosUsuarios : plantas
RegistrarPlanta --> ConsultaRangos : especies
CasosDePlanta --> PuertosUsuarios
VincularSensor --> PuertosUsuarios : plantas, sensores
VincularSensor --> GeneradorSecretos : secretos
RecibirMedicionDeSensor --> PuertosUsuarios : sensores
RecibirMedicionDeSensor --> DiagnosticarPlantaDeUsuario : diagnosticar

' ---- el puente entre el corte 1 y el corte 2: la unica conexion real -------
DiagnosticarPlantaDeUsuario --> PuertosUsuarios : plantas, historial
DiagnosticarPlantaDeUsuario -[#B85450,bold]-> ServicioDiagnostico : servicio\n(compone el nucleo, no lo modifica)
Planta --> Usuario : usuarioId (ref)
Sensor --> Planta : plantaId (ref)
RegistroMedicion --> Planta : plantaId (ref)
RegistroMedicion --> EstadoGlobal : estado

' =========================================================================
' TIEMPO REAL — websocket y MQTT (futuro, todavia no implementado).
' Reutilizarian el MISMO caso de uso DiagnosticarPlantaDeUsuario que ya usa
' la ruta REST de mediciones manuales y la de sensores.
' =========================================================================
WebSocketPlantas ..> Autenticacion : (futuro) reutilizaria el token
WebSocketPlantas -[#B85450,bold]-> DiagnosticarPlantaDeUsuario : mismo caso de uso\nque la ruta REST
MqttListener -[#B85450,bold]-> DiagnosticarPlantaDeUsuario : mismo caso de uso\n(escenario MQTT del enunciado)
DiagnosticarPlantaDeUsuario --> NotificadorDiagnosticos : notificador (futuro)
NotificadorWebSocket ..> WebSocketPlantas : empuja por el socket

@enduml

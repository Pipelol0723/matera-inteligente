%% Puertos de salida del dominio (backend/dominio/puertos.py y puertos_usuarios.py) y las clases de infraestructura que los implementan.
%% Toda flecha va de infraestructura hacia el dominio (RA5, DIP). Los puertos de entrada (dominio/puertos_entrada.py) se dibujan en los diagramas de aplicacion.
%% Verde: dominio. Azul: infraestructura. Borde grueso: se agrego en el corte 2 o en la fase 2 (puertos de pocos metodos, JWT y tabla en CSV).
classDiagram
    direction LR

    namespace dominio {
        class ConsultaRangos {
            <<interface>>
            +rangos_de(especie: str) Especie o None
        }
        class CatalogoEspecies {
            <<interface>>
            +listar() list~Especie~
        }
        class RegistroEspecies {
            <<interface>>
            +agregar(especie: Especie)
        }
        class ConsultaCuentas {
            <<interface>>
            +por_correo(correo: Correo) Usuario o None
            +por_id(usuario_id: int) Usuario o None
        }
        class RegistroCuentas {
            <<interface>>
            +guardar(usuario: Usuario) Usuario
            +eliminar(usuario_id: int)
        }
        class ListadoCuentas {
            <<interface>>
            +resumenes() list~ResumenUsuario~
        }
        class SesionesAbiertas {
            <<interface>>
            +abrir(sesion: Sesion)
            +abierta(token_id: str) Sesion o None
            +cerrar(token_id: str)
            +cerrar_de_usuario(usuario_id: int)
        }
        class ConsultaPlantas {
            <<interface>>
            +por_id(planta_id: int) Planta o None
            +de_usuario(usuario_id: int) list~Planta~
        }
        class RegistroPlantas {
            <<interface>>
            +guardar_con_sensor(planta: Planta, codigo: CodigoSensor, hash_clave: str) Planta
            +eliminar(planta: Planta)
        }
        class SensoresVinculados {
            <<interface>>
            +por_codigo(codigo: CodigoSensor) Sensor o None
            +de_planta(planta_id: int) Sensor o None
            +reemplazar(planta: Planta, sensor: Sensor)
        }
        class CredencialesSensor {
            <<interface>>
            +renovar(sensor: Sensor, token_id: str) bool
            +planta_con_token(codigo: CodigoSensor, token_id: str) Planta o None
        }
        class HistorialMediciones {
            <<interface>>
            +agregar(planta: Planta, registro: RegistroMedicion)
            +de_planta(planta_id: int, limite: int) list~RegistroMedicion~
            +ultimo_de(planta_id: int) RegistroMedicion o None
        }
        class NotificadorDiagnosticos {
            <<interface>>
            +publicar(usuario_id: int, planta: Planta, registro: RegistroMedicion, diagnostico: Diagnostico)
        }
        class EmisorTokens {
            <<interface>>
            +emitir(identidad: IdentidadUsuario o IdentidadDispositivo, vence_en: datetime) str
        }
        class VerificadorTokens {
            <<interface>>
            +verificar_usuario(token: str) IdentidadUsuario
            +verificar_dispositivo(token: str) IdentidadDispositivo
        }
        class Cifrador {
            <<interface>>
            +cifrar(texto: str) str
            +verificar(texto: str, cifrado: str) bool
        }
        class GeneradorSecretos {
            <<interface>>
            +nuevo() str
            +huella(secreto: str) str
            +coincide(secreto: str, huella: str) bool
        }
        class Reloj {
            <<interface>>
            +ahora() datetime
        }
    }

    namespace infraestructura {
        class RepositorioEspeciesCsv {
            -ruta: Path
            -especies: dict
        }
        class EspeciesDeSoloLectura
        class RegistroEspeciesConCopiaCsv {
            -registro: RegistroEspecies
            -catalogo: CatalogoEspecies
            -ruta: Path
        }
        class RepositorioEspeciesSqlite {
            -bd: BaseDatos
        }
        class RepositorioUsuariosSqlite {
            -bd: BaseDatos
        }
        class RepositorioSesionesSqlite {
            -bd: BaseDatos
        }
        class RepositorioPlantasSqlite {
            -bd: BaseDatos
        }
        class RepositorioSensoresSqlite {
            -bd: BaseDatos
        }
        class HistorialMedicionesSqlite {
            -bd: BaseDatos
        }
        class TokensJwt {
            -secreto: str
            -reloj: Reloj
        }
        class CifradorPbkdf2 {
            -iteraciones: int = 600000
        }
        class GeneradorSecretosSeguro {
            usa secrets, hashlib y hmac
        }
        class RelojSistema {
            usa datetime.now
        }
        class BaseDatos {
            -ruta: Path
            +conexion() Connection
            +preparar() BaseDatos
        }
        class NotificadorWebSocket {
            -canales: CanalesTiempoReal
            -formato: medicion_en_vivo_a_json
        }
        class CanalesTiempoReal {
            -por_usuario: canales de cada usuario
            +conectado(usuario_id, canal)
            +conectados(usuario_id) int
            +enviar(usuario_id, texto) int
        }
    }

    RepositorioEspeciesCsv ..|> ConsultaRangos
    RepositorioEspeciesCsv ..|> CatalogoEspecies
    EspeciesDeSoloLectura ..|> RegistroEspecies
    RegistroEspeciesConCopiaCsv ..|> RegistroEspecies
    RegistroEspeciesConCopiaCsv --> RegistroEspecies : registro
    RegistroEspeciesConCopiaCsv --> CatalogoEspecies : catalogo
    RepositorioEspeciesSqlite ..|> ConsultaRangos
    RepositorioEspeciesSqlite ..|> CatalogoEspecies
    RepositorioEspeciesSqlite ..|> RegistroEspecies
    RepositorioUsuariosSqlite ..|> ConsultaCuentas
    RepositorioUsuariosSqlite ..|> RegistroCuentas
    RepositorioUsuariosSqlite ..|> ListadoCuentas
    RepositorioSesionesSqlite ..|> SesionesAbiertas
    RepositorioPlantasSqlite ..|> ConsultaPlantas
    RepositorioPlantasSqlite ..|> RegistroPlantas
    RepositorioSensoresSqlite ..|> SensoresVinculados
    RepositorioSensoresSqlite ..|> CredencialesSensor
    HistorialMedicionesSqlite ..|> HistorialMediciones
    TokensJwt ..|> EmisorTokens
    TokensJwt ..|> VerificadorTokens
    TokensJwt --> Reloj : reloj
    CifradorPbkdf2 ..|> Cifrador
    GeneradorSecretosSeguro ..|> GeneradorSecretos
    RelojSistema ..|> Reloj
    NotificadorWebSocket ..|> NotificadorDiagnosticos

    note for BaseDatos "Abre una conexión por operación y activa<br>PRAGMA foreign_keys: Flask atiende cada petición<br>en un hilo y sqlite3 no comparte conexiones<br>entre hilos. La usan los seis repositorios SQLite."
    note for CanalesTiempoReal "Las conexiones abiertas de cada usuario,<br>con un candado: se usa desde varios hilos.<br>La ruta del WebSocket (presentación) registra<br>cada pestaña; main.py le pasa estos mismos canales."
    note for TokensJwt "Firma HS256 con un secreto del servidor. El token trae<br>sub, alcance (usuario o lecturas), jti, iat y exp.<br>Es el único archivo que importa jwt (PyJWT)."
    note for EspeciesDeSoloLectura "Con MATERA_TABLA_REFERENCIA=csv, agregar una especie<br>lanza TablaDeSoloLectura: el CSV es una copia de la base."
    note for RegistroEspeciesConCopiaCsv "Con MATERA_TABLA_REFERENCIA=bd, envuelve a<br>RepositorioEspeciesSqlite: después de agregar, reescribe<br>la copia en CSV. El adaptador SQLite no sabe del archivo."


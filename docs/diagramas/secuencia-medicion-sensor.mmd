%% Secuencia del corte 2, fase 2 hexagonal (implementada): un dispositivo (la placa ESP32 o simulador_esp32.py) manda una lectura en dos pasos.
%% Paso 1: canjea la clave del sensor por un JWT de alcance "lecturas". Paso 2: reporta la lectura con ese JWT, que se diagnostica
%% con el ServicioDiagnostico del corte 1, se guarda en el historial y se avisa en vivo.
sequenceDiagram
    autonumber
    participant ESP as ESP32<br/>(o simulador_esp32.py)
    participant RD as rutas_dispositivos.py<br/>(presentación)
    participant E as esquemas_dispositivos.py<br/>(presentación)
    participant TK as VerificadorTokens y<br/>EmisorTokens (puertos)
    participant CC as CanjearClaveDispositivo<br/>(aplicación)
    participant RL as RegistrarLectura<br/>(aplicación)
    participant PU as SensoresVinculados, CredencialesSensor,<br/>ConsultaPlantas, GeneradorSecretos<br/>y Reloj (puertos)
    participant DU as DiagnosticarPlantaDeUsuario<br/>(aplicación)
    participant S as ServicioDiagnostico<br/>(dominio, corte 1)
    participant HN as HistorialMediciones y<br/>NotificadorDiagnosticos (puertos)

    rect rgb(238, 244, 250)
        Note over ESP,HN: Paso 1: canjear la clave por un token. La clave se muestra una sola vez, al crear la matera
        ESP ->> RD: POST /api/v1/dispositivos/{código}/token<br/>cuerpo {"clave"}
        RD ->> E: clave_desde_json(cuerpo)
        E -->> RD: clave
        RD ->> CC: ejecutar(código, clave)
        CC ->> PU: SensoresVinculados.por_codigo(CodigoSensor)
        PU -->> CC: Sensor con la huella de su clave, o None
        CC ->> PU: GeneradorSecretos.coincide(clave, huella), si el sensor existe
        alt código mal escrito, sensor inexistente o clave incorrecta
            CC --x RD: ClaveSensorInvalida
            RD -->> ESP: 401 CLAVE_SENSOR_INVALIDA
        else clave correcta
            CC ->> PU: GeneradorSecretos.nuevo(): el id del token (token_id)
            CC ->> PU: CredencialesSensor.renovar(sensor, token_id)
            alt el sensor cambió entre tanto (otra clave u otra planta)
                PU -->> CC: False
                CC --x RD: ClaveSensorInvalida
                RD -->> ESP: 401 CLAVE_SENSOR_INVALIDA
            else sigue siendo el mismo sensor
                PU -->> CC: True: token_id queda como el único vigente de ese sensor
                CC ->> PU: Reloj.ahora() + duración: vence_en
                CC ->> TK: EmisorTokens.emitir(IdentidadDispositivo(código, token_id), vence_en)
                TK -->> CC: JWT firmado, con alcance «lecturas»
                CC -->> RD: TokenDispositivo: token y vence_en
                RD -->> ESP: 200 JSON {token, venceEn}
            end
        end
    end

    rect rgb(238, 248, 238)
        Note over ESP,HN: Paso 2: reportar la lectura con el token del paso 1
        ESP ->> RD: POST /api/v1/dispositivos/{código}/lecturas<br/>Authorization: Bearer JWT<br/>cuerpo {dispositivo, momento, lecturas}
        RD ->> TK: _con_dispositivo: verificar_dispositivo(token)
        Note over RD,TK: token_bearer saca el texto de la cabecera.<br/>Sin cabecera Bearer da el mismo 401 que un token malo
        alt la firma no es válida, venció o falta el Bearer
            TK --x RD: CredencialDispositivoInvalida
            RD -->> ESP: 401 CREDENCIAL_DISPOSITIVO_INVALIDA
        else el token es de otro alcance (por ejemplo, el de un usuario)
            TK --x RD: AlcanceInvalido
            RD -->> ESP: 403 ALCANCE_INVALIDO
        else el token vale, pero la URL es de otro sensor
            TK -->> RD: IdentidadDispositivo(código, token_id)
            RD -->> ESP: 403 DISPOSITIVO_AJENO
        else el token vale para el sensor de la URL
            TK -->> RD: IdentidadDispositivo(código, token_id)
            RD ->> E: reporte_desde_json(cuerpo)
            Note over E: la hora pasa a UTC y la Medicion sale de medicion_desde_json:<br/>los límites físicos se validan en Lectura. Sin zona horaria<br/>MOMENTO_INVALIDO, y un valor imposible PARAMETRO_INVALIDO (los dos 400)
            E -->> RD: ReporteDeDispositivo: dispositivo, momento y Medicion
            RD ->> RL: ejecutar(identidad, reporte)
            RL ->> PU: CredencialesSensor.planta_con_token(código, token_id)
            PU -->> RL: Planta con su dueño, o None
            alt None: otro canje o un cambio de sensor dejó sin efecto este token
                RL --x RD: CredencialDispositivoInvalida
                RD -->> ESP: 401 CREDENCIAL_DISPOSITIVO_INVALIDA
                Note over ESP: la placa canjea su clave otra vez (paso 1)
            else el dispositivo del cuerpo no es el del token
                RL --x RD: DispositivoAjeno
                RD -->> ESP: 403 DISPOSITIVO_AJENO
            else reporte.exigir_que_no_sea_futuro(Reloj.ahora()) falla: más de 2 min adelantada
                RL --x RD: MomentoInvalido
                RD -->> ESP: 400 MOMENTO_INVALIDO
            else la lectura se acepta
                RL ->> DU: ejecutar(planta.usuario_id, planta.id, medicion, origen = código, momento)
                DU ->> PU: ConsultaPlantas.por_id(planta_id)
                PU -->> DU: Planta
                Note over DU: buscar_planta_propia llama a Planta.exigir_dueno(usuario_id):<br/>la regla de propiedad es del dominio. Una planta ajena o<br/>inexistente da PlantaNoEncontrada
                DU ->> S: diagnosticar(planta.especie, medicion)
                Note over S: el mismo recorrido del corte 1<br/>ConsultaRangos, EvaluadorPlanta, ReglaHibrida
                S -->> DU: Diagnostico
                DU ->> HN: HistorialMediciones.agregar(RegistroMedicion.desde(diagnostico, planta.id, momento, origen))
                DU ->> HN: NotificadorDiagnosticos.publicar(dueño, planta, registro, diagnostico)
                Note over HN: NotificadorWebSocket lo manda solo a las<br/>pestañas abiertas del dueño. Si falla, la<br/>medición ya quedó guardada: solo se registra en el log
                DU -->> RL: ResultadoMedicion
                RL -->> RD: ResultadoMedicion: planta, diagnóstico y momento
                RD -->> ESP: 201 JSON con la planta, el momento y el diagnóstico
            end
        end
    end
